# Exemplo de arquivo .env.production para servidor otimizado
# Copie como .env e ajuste credenciais reais

NODE_ENV=production
LOG_LEVEL=info
PORT=3000

# ============ Database ============
# Postgres com pool de 150 conexões
# Ajuste host/user/password para sua instância
DATABASE_URL="postgresql://broadcast_user:SEU_PASSWORD@postgres.prod.internal:5432/beecrm_broadcast?schema=public&sslmode=require&connection_limit=150&statement_timeout=30000"

# Prisma logs (desabilitar em produção para performance)
# Valores: error, warn, info, debug
PRISMA_LOG_LEVEL=warn

# ============ Redis ============
# Pode ser local ou gerenciado (AWS ElastiCache, etc)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=seu_redis_password
REDIS_DB=0

# ============ Diogenes/WhatsApp API ============
DIOGENES_URL=https://diogenes.beecrm.io
HERMES_API_KEY=seu_hermes_api_key
DIOGENES_TEST_MODE=false

# ============ CRM Webhook ============
# Endpoint que receberá atualizações de campanha
CRM_WEBHOOK_URL=https://crm.beecrm.io/webhooks/broadcast
CRM_WEBHOOK_TIMEOUT=10000
CRM_WEBHOOK_MAX_RETRIES=3

# ============ Logging ============
LOG_DIR=./logs
LOG_FORMAT=json

# ============ Performance ============
# Node.js memory (overridden by ecosystem.config.js)
# NODE_OPTIONS=--max-old-space-size=2048

# ============ Debug/Testing ============
# Defina como true apenas em staging/test
DEBUG=false
