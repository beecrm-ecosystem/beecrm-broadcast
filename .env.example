# Application
NODE_ENV=development
PORT=4000

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-jwt-key-change-this-in-production
JWT_REFRESH_EXPIRES_IN=7d

# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:4001/folheto?schema=public"

# MongoDB
MONGODB_URI=mongodb://mongo:mongo@localhost:27017/folheto?authSource=admin

# Redis
REDIS_HOST=localhost
REDIS_PORT=4002

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=4003
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=folheto

# RCS (Pontaltech)
RCS_API_URL=https://rcs.pontaltech.com.br/api
RCS_API_TOKEN=
