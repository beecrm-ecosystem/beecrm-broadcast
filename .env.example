# Application
NODE_ENV=development
PORT=4000

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-jwt-key-change-this-in-production
JWT_REFRESH_EXPIRES_IN=7d

# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:4001/folheto?schema=public"

# MongoDB
MONGODB_URI=mongodb://mongo:mongo@localhost:27017/folheto?authSource=admin

# Redis
REDIS_HOST=localhost
REDIS_PORT=4002

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=4003
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=folheto

# RCS (Pontaltech)
RCS_API_URL=https://rcs.pontaltech.com.br/api
RCS_API_TOKEN=

# BeeCRM webhook HMAC — deve ser IGUAL ao CAMPAIGN_WEBHOOK_SECRET do BeeCRM.
# Gerar com: openssl rand -hex 32
# Esquema: X-Bee-Signature = HMAC-SHA256(timestamp + '.' + raw_body, secret)
CAMPAIGN_WEBHOOK_SECRET=

# Auth da REST API (/api/broadcast, /api/metrics, ...) consumida pelo BeeCRM.
# Deve ser IGUAL ao BROADCAST_SERVICE_TOKEN do BeeCRM. O ApiTokenGuard exige
# Authorization: Bearer <token>. Se NÃO for setado, o guard NÃO bloqueia
# (apenas loga) — rollout fail-open pra não derrubar a fleet; setar habilita.
# Gerar com: openssl rand -hex 32
BROADCAST_SERVICE_TOKEN=
