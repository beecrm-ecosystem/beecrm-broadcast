# Application
NODE_ENV=development
PORT=4000

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-jwt-key-change-this-in-production
JWT_REFRESH_EXPIRES_IN=7d

# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:4001/folheto?schema=public"

# MongoDB
MONGODB_URI=mongodb://mongo:mongo@localhost:27017/folheto?authSource=admin

# Redis
REDIS_HOST=localhost
REDIS_PORT=4002

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=4003
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=folheto

# RCS (Pontaltech)
RCS_API_URL=https://rcs.pontaltech.com.br/api
RCS_API_TOKEN=

# BeeCRM webhook HMAC — deve ser IGUAL ao CAMPAIGN_WEBHOOK_SECRET do BeeCRM.
# Gerar com: openssl rand -hex 32
# Esquema: X-Bee-Signature = HMAC-SHA256(timestamp + '.' + raw_body, secret)
CAMPAIGN_WEBHOOK_SECRET=

# Hosts aceitos em metadata.webhookUrl (URL do webhook que o BeeCRM manda no
# create; na URL unica o dominio do tenant nao existe no DNS). Lista separada
# por virgula, so o host, exige HTTPS. Vazio = recusa o webhookUrl e usa o
# calculo antigo pelo channel. Ex.: api.beecrm.io,apies.beecrm.io
CRM_WEBHOOK_ALLOWED_HOSTS=

# Auth da REST API (/api/broadcast, /api/metrics, ...) consumida pelo BeeCRM.
# Deve ser IGUAL ao BROADCAST_SERVICE_TOKEN do BeeCRM. O ApiTokenGuard exige
# Authorization: Bearer <token>. Se NÃO for setado, o guard NÃO bloqueia
# (apenas loga) — rollout fail-open pra não derrubar a fleet; setar habilita.
# Gerar com: openssl rand -hex 32
BROADCAST_SERVICE_TOKEN=

# Autenticidade dos webhooks de PROVEDOR (/api/webhook/campaign-status, /diogenes, /rcs).
# Token compartilhado com quem chama (Diogenes/encaminhador): header X-Webhook-Token ou ultimo
# segmento da URL (/api/webhook/<rota>/<token>; prefira o header — URL vai para log de acesso).
# Gerar com: openssl rand -hex 32
# Vazio = rotas abertas como antes (so loga aviso de hora em hora); setar habilita o bloqueio.
PROVIDER_WEBHOOK_TOKEN=
# App Secret da Meta: se setado, o campaign-status aceita tambem X-Hub-Signature-256 valido
# (HMAC-SHA256 do corpo cru). Util se a Meta, ou um repasse que preserve corpo e header, chamar.
META_APP_SECRET=

# Logs de webhook em arquivo (file-logger) — PII.
# WEBHOOK_LOG_PAYLOAD=true grava o payload cru (telefones/conteúdo) — só em debug.
# Por padrão o payload é omitido e telefones são mascarados.
WEBHOOK_LOG_PAYLOAD=false
# Dias de retenção dos logs de webhook (limpeza automática diária).
WEBHOOK_LOG_RETENTION_DAYS=30
